{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetPilot",
  "version": "0.1.1",
  "identifier": "local.netpilot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NetPilot",
        "width": 1100,
        "height": 780,
        "minWidth": 800,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0ODI5RTE0NEU0OUFBQTgKUldTb3FrbE9GSjZDUkNGTUJsVTVuYVFlS0gxeUo1citISjVPRkJPUzA1U0JYV3orSU9QU0tWKzIK",
      "endpoints": [
        "https://github.com/tayyemibraheem/NetPilot-build/releases/download/netpilot-updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
